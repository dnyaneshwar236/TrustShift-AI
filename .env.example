# TrustShift AI - Root Environment Configuration Example

# Project Environment ('development' or 'production')
ENVIRONMENT=development

# Database Settings (PostgreSQL or local SQLite)
DATABASE_URL=sqlite:///./trustshift.db
# PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustshift
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=trustshift

# Cryptography & JWT Security
SECRET_KEY=demo_secret_key_trustshift_2026_enterprise_production_ready_64chars
ACCESS_TOKEN_EXPIRE_MINUTES=480

# API Endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
STORAGE_PATH=./backend/storage

# Third-Party Identity & Telephony Providers (Optional)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
