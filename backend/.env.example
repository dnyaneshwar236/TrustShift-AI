# TrustShift AI - Backend Configuration Environment Example

# Database (PostgreSQL for production, SQLite local development fallback)
DATABASE_URL=sqlite:///./trustshift.db
# For PostgreSQL:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/trustshift

# Cryptography & Security
SECRET_KEY=demo_secret_key_trustshift_2026_enterprise_production_ready_64chars
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

# Environment ('development' or 'production')
ENVIRONMENT=development

# CORS Allowlist (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Report & Storage paths
STORAGE_PATH=./storage

# External Identity Providers (Optional - simulated adapters are used by default)
# AWS Rekognition / FaceTec for Real Biometrics
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Twilio SMS / Telephony Gateway
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
